<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.boardserver.mapper.PostSearchMapper">

    <select id="selectPosts" resultType="com.project.boardserver.dto.PostDTO">
        SELECT `id`,
        `name`,
        `isAdmin`,
        `contents`,
        `createTime`,
        `views`,
        `categoryId`,
        `userId`,
        `fileId`,
        `updateTime`
        FROM `post`
        WHERE 1=1
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="contents != null and contents != ''">
            AND contents LIKE CONCAT('%', #{contents}, '%')
        </if>
        <if test="categoryId != 0">
            AND categoryId = #{categoryId}
        </if>

        <if test="sortStatus != null">
            <choose>
                <when test="sortStatus.name() == 'NEWEST'">
                    ORDER BY createTime DESC
                </when>
                <when test="sortStatus.name() == 'OLDEST'">
                    ORDER BY createTime ASC
                </when>
                <when test="sortStatus.name() == 'CATEGORIES'">
                    ORDER BY categoryId ASC
                </when>
                <otherwise>
                    ORDER BY createTime DESC </otherwise>
            </choose>
        </if>
    </select>
</mapper>