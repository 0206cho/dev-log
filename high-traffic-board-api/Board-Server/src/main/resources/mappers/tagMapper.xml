<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.boardserver.mapper.TagMapper">

    <!-- 태그 등록 -->
    <insert id="register" parameterType="com.project.boardserver.dto.TagDTO">
        INSERT INTO tag
            (name, url )
        VALUES (#{name}, #{url})
        <selectKey keyProperty="id" resultType="Integer">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <!-- 태그 수정 -->
    <update id="update" parameterType="com.project.boardserver.dto.TagDTO">
        UPDATE tag
        SET name = #{name},
            url = #{url}
        WHERE id = #{id}
    </update>

    <!-- 태그 삭제 -->
    <delete id="delete" >
        DELETE FROM tag
        WHERE id = #{tagId}
    </delete>

    <!-- 태그 - 게시글 매핑 -->
    <insert id="createPostTag">
        INSERT INTO posttag(tagId, postId)
        VALUES (#{tagId}, #{postId})
    </insert>

</mapper>